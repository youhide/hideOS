# hideOS kernel configuration, merged over the architecture's defconfig.
# Every line here is checked to be in the final .config.
CONFIG_LOCALVERSION="-hideos"
# CONFIG_LOCALVERSION_AUTO is not set

# Booting from an initramfs, with oxinit as PID 1.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# What oxinit supervises with.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y

# The serial console QEMU and CI read.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Virtual hardware.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# The sealed system (H2): composefs is EROFS over overlay, verified by
# fs-verity, on btrfs.
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_FS_VERITY=y
CONFIG_BTRFS_FS=y
