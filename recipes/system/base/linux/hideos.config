# hideOS kernel configuration, merged over the architecture's defconfig.
# Every line here is checked to be in the final .config.
CONFIG_LOCALVERSION="-hideos"
# CONFIG_LOCALVERSION_AUTO is not set

# Booting from an initramfs, with oxinit as PID 1.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# What oxinit supervises with.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y

# The serial console QEMU and CI read.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Virtual hardware.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# The sealed system (H2): composefs is EROFS over overlay, verified by
# fs-verity, on btrfs.
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_FS_VERITY=y
CONFIG_BTRFS_FS=y

# A console on the screen under UEFI, and the first framebuffer the
# desktop draws on: the firmware's framebuffer handed to DRM, emulated as
# fbdev for the text console. virtio-gpu is what QEMU gives the desktop.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_VIRTIO_GPU=y

# EFI variables: hidestage reports whether Secure Boot is on, and the boot
# manager's boot counting (H3) lives in them.
CONFIG_EFIVAR_FS=y

# The watchdog that turns a boot that hangs into a failed boot: hidestage
# arms it, `hide boot-ok` disarms it. QEMU's; real machines' come with H4.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_I6300ESB_WDT=y

# Wi-Fi (H4): the 802.11 stack, and the kernel crypto API iwd does its
# cryptography through — it carries no TLS library of its own. Drivers and
# their firmware come with real hardware.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_DES=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# Suspend to RAM and hibernation to the swap file (H4). hidestage resumes;
# see `hide swap` for how it finds the image.
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_SLEEP=y
CONFIG_RTC_DRV_CMOS=y

# The encrypted root (H4): dm-crypt over the LUKS2 partition, AES-XTS, and
# the TPM that holds its key — on the bus (TIS) or in firmware (CRB).
# hidestage opens it, so all of it is built in. (AES-NI is in x86's
# defconfig already; this fragment is every architecture's.)
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
# Flatpak: bubblewrap sandboxes with user namespaces, unprivileged; the
# document portal and flatpak's revokefs are FUSE file systems.
CONFIG_USER_NS=y
CONFIG_FUSE_FS=y
# Real hardware (H4). On x86_64 the base is Arch Linux's configuration, for
# its drivers, built as modules that udev loads; what the boot needs before
# the root is mounted is built in: the disks, the ESP's filesystem, the
# display — and USB sticks, which the installer boots from and reads its
# payload off, running from memory with no modules. Modules are not signed: they are in /usr, which the seal
# already covers, and a signing key made at build time would make every
# build different. No Rust in the kernel and no BTF yet: they need tools
# the toolchain does not have (bindgen, pahole). No in-kernel headers
# archive: it needs cpio at build time, and nothing reads it. No lockdown
# either, which would require signed modules: lockdown and module signing
# come with hideOS's own Secure Boot keys (ARCHITECTURE, "Security").
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DRM=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_TRUSTED_KEYS=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_RUST is not set
# CONFIG_IKHEADERS is not set
