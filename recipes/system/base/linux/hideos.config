# hideOS kernel configuration, merged over the architecture's defconfig.
# Every line here is checked to be in the final .config.
CONFIG_LOCALVERSION="-hideos"
# CONFIG_LOCALVERSION_AUTO is not set

# Booting from an initramfs, with oxinit as PID 1.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# What oxinit supervises with.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y

# The serial console QEMU and CI read.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Virtual hardware.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# The sealed system (H2): composefs is EROFS over overlay, verified by
# fs-verity, on btrfs.
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_FS_VERITY=y
CONFIG_BTRFS_FS=y

# A console on the screen under UEFI, and the first framebuffer the
# desktop draws on: the firmware's framebuffer handed to DRM, emulated as
# fbdev for the text console. virtio-gpu is what QEMU gives the desktop.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_VIRTIO_GPU=y

# EFI variables: hidestage reports whether Secure Boot is on, and the boot
# manager's boot counting (H3) lives in them.
CONFIG_EFIVAR_FS=y

# The watchdog that turns a boot that hangs into a failed boot: hidestage
# arms it, `hide boot-ok` disarms it. QEMU's; real machines' come with H4.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_I6300ESB_WDT=y
